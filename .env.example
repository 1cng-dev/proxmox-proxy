# Proxmox Connection
# Use a least-privilege API token (VM.Audit, VM.PowerMgmt, VM.Console) — not root@pam.
PROXMOX_URL=https://YOUR_PROXMOX_IP:8006
PROXMOX_TOKEN=PVEAPIToken=proxcy-api@pve!YOUR_TOKEN_NAME=YOUR_TOKEN_SECRET
PROXMOX_DEFAULT_NODE=node1

# Server Config
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://your-vmp-domain.com

# Supabase — used for JWT authentication, VM ownership authorization, and audit logging
# Service role key is server-side only — never send it to a client.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# VNC console session token TTL (seconds) — see console/vncwebsocket flow in the architecture doc
VNC_TOKEN_TTL_SECONDS=60

# Symmetric key for VM login-credential encryption (pgcrypto pgp_sym_encrypt/decrypt,
# via the set_vm_password/get_vm_password Postgres functions). Server-side only —
# never stored in the database, never sent to a client. Generate with e.g.
# `openssl rand -base64 32`. Rotating this key re-encrypts nothing automatically —
# existing password_encrypted values become undecryptable if it changes.
VM_CREDENTIAL_KEY=YOUR_LONG_RANDOM_SECRET
